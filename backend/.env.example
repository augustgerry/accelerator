# --- LLM provider (pluggable) ---
LLM_PROVIDER=claude          # claude | gemini | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Database (Supabase / any Postgres with pgvector) ---
DATABASE_URL=postgresql://user:password@host:5432/knowledge_accelerator

# --- Google Drive (document source) ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CREDENTIALS_PATH=./credentials.json

# --- Workspace (multi-tenant ready even for single-user MVP) ---
DEFAULT_WORKSPACE_ID=smg-presales-mvp

# --- External research (web_search + web_fetch, ~$10/1000 searches) ---
ENABLE_EXTERNAL_RESEARCH=false
